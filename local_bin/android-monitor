#!/bin/bash
# ==============================================================================
# Android Tablet as Second Monitor for Hyprland (Wayland)
# Default: LEFT SIDE with 1.5x Tablet Scaling
# ==============================================================================

ACTION="${1:-start}"

if [ "$ACTION" = "stop" ]; then
    echo "🛑 Stopping Virtual Monitor..."
    pkill -9 -f wayvnc 2>/dev/null
    for h in $(hyprctl monitors | grep "HEADLESS" | awk '{print $2}'); do
        hyprctl output remove "$h" 2>/dev/null
    done
    notify-send -u normal -a "Android Monitor" "Android Monitor Stopped" "Virtual screen has been removed."
    exit 0
fi

# Default Position: LEFT of laptop screen (-1280x0) with 1.5x scale
POSITION="-1280x0"
if [ "$ACTION" = "right" ]; then
    POSITION="1920x0"
    echo "📍 Positioning Tablet to the RIGHT of laptop screen"
else
    echo "📍 Positioning Tablet to the LEFT of laptop screen"
fi

echo "🚀 Starting Android Second Monitor for Hyprland..."

# Clean up any leftover previous wayvnc or headless displays
pkill -9 -f wayvnc 2>/dev/null
for h in $(hyprctl monitors | grep "HEADLESS" | awk '{print $2}'); do
    hyprctl output remove "$h" 2>/dev/null
done

# 1. Create Virtual Second Screen in Hyprland
hyprctl output create headless
sleep 1

HEADLESS_NAME=$(hyprctl monitors | grep "HEADLESS" | awk '{print $2}' | tail -n 1)

if [ -z "$HEADLESS_NAME" ]; then
    echo "❌ Error: Failed to create headless output."
    exit 1
fi

# 2. Apply LEFT Position (-1280x0) and 1.5x Tablet UI Scaling
hyprctl eval "hl.monitor({ output = \"$HEADLESS_NAME\", mode = \"1920x1080@60\", position = \"$POSITION\", scale = 1.5 })" 2>/dev/null
echo "✅ Created Virtual Screen: $HEADLESS_NAME with 1.5x Scaling on the LEFT ($POSITION)"

# 3. Setup ADB USB reverse port forwarding if USB is connected
if which adb >/dev/null 2>&1; then
    adb reverse tcp:5900 tcp:5900 2>/dev/null
fi

# 4. Start WayVNC attached specifically to the dynamic HEADLESS monitor
WAYLAND_DISPLAY=wayland-1 XDG_RUNTIME_DIR=/run/user/1000 wayvnc -o "$HEADLESS_NAME" 0.0.0.0 5900 > /dev/null 2>&1 &

sleep 1

# Detect IPs
WIFI_IP=$(ip addr show wlan0 2>/dev/null | grep "inet " | awk '{print $2}' | cut -d/ -f1)
USB_IP=$(ip addr show enp0s20f0u1 2>/dev/null | grep "inet " | awk '{print $2}' | cut -d/ -f1)

notify-send -u critical -a "Android Monitor" "Virtual Monitor Ready (1.5x Left)!" "USB: localhost:5900\nWi-Fi: ${WIFI_IP:-none}:5900"

echo ""
echo "=================================================================="
echo "✅ VIRTUAL MONITOR IS READY (1.5x SCALING ON THE LEFT)!"
echo "=================================================================="
echo "📱 In your Android VNC App (AVNC / VNC Viewer), Connect to:"
echo ""
echo "⚡ If using USB Cable with USB-Debugging:"
echo "   👉 Address: localhost:5900 (or 127.0.0.1:5900)"
echo ""
if [ -n "$USB_IP" ]; then
    echo "🔌 If using USB Tethering:"
    echo "   👉 Address: $USB_IP:5900"
    echo ""
fi
if [ -n "$WIFI_IP" ]; then
    echo "📶 If using Same Wi-Fi:"
    echo "   👉 Address: $WIFI_IP:5900"
    echo ""
fi
echo "🔑 Password: (None / Leave empty)"
echo "=================================================================="
