#!/bin/bash
# ==============================================================================
# Android Tablet as Second Monitor for Hyprland (Wayland)
# Optimized for Samsung Galaxy Tab A9 (Native 5:3 / 1340x800 - 2010x1200 @ 1.5x)
# Hardware GPU Accelerated (-g) & 60 FPS unlocked (-f 60)
# Auto-detects USB Tethering & Wi-Fi interfaces
# Automatically draws Wallpaper on Tablet Screen
# ==============================================================================

ACTION="${1:-start}"

if [ "$ACTION" = "stop" ]; then
    echo "🛑 Stopping Virtual Monitor..."
    pkill -9 -f wayvnc 2>/dev/null
    for h in $(hyprctl monitors | grep "HEADLESS" | awk '{print $2}'); do
        hyprctl output remove "$h" 2>/dev/null
    done
    notify-send -u normal -a "Android Monitor" "Android Monitor Stopped" "Virtual screen has been removed."
    exit 0
fi

# Samsung Galaxy Tab A9 native 5:3 aspect ratio: 2010x1200 at 1.5x scale (1340x800 logical)
RESOLUTION="2010x1200@60"
SCALE="1.5"

POSITION="-1340x0"
if [ "$ACTION" = "right" ]; then
    POSITION="1920x0"
    echo "📍 Positioning Tablet to the RIGHT of laptop screen"
else
    echo "📍 Positioning Tablet to the LEFT of laptop screen"
fi

echo "🚀 Starting Android Second Monitor for Hyprland (GPU 60 FPS Accelerated)..."

# Clean up any leftover previous wayvnc or headless displays
pkill -9 -f wayvnc 2>/dev/null
for h in $(hyprctl monitors | grep "HEADLESS" | awk '{print $2}'); do
    hyprctl output remove "$h" 2>/dev/null
done

# 1. Create Virtual Second Screen in Hyprland
hyprctl output create headless
sleep 1

HEADLESS_NAME=$(hyprctl monitors | grep "HEADLESS" | awk '{print $2}' | tail -n 1)

if [ -z "$HEADLESS_NAME" ]; then
    echo "❌ Error: Failed to create headless output."
    exit 1
fi

# 2. Apply Samsung Tab A9 Native Resolution (2010x1200 / 1.5x on LEFT)
hyprctl eval "hl.monitor({ output = \"$HEADLESS_NAME\", mode = \"$RESOLUTION\", position = \"$POSITION\", scale = $SCALE })" 2>/dev/null
echo "✅ Created Virtual Screen: $HEADLESS_NAME ($RESOLUTION, scale $SCALE at $POSITION)"

# 3. Reload Wallpaper so it renders on Tablet Screen immediately
pkill -9 hyprpaper 2>/dev/null
sleep 0.2
WAYLAND_DISPLAY=wayland-1 XDG_RUNTIME_DIR=/run/user/1000 hyprpaper > /dev/null 2>&1 &

# 4. Setup ADB USB reverse port forwarding if USB is connected
if which adb >/dev/null 2>&1; then
    adb reverse tcp:5900 tcp:5900 2>/dev/null
fi

# 5. Start WayVNC with GPU Acceleration (-g) and 60 FPS (-f 60)
WAYLAND_DISPLAY=wayland-1 XDG_RUNTIME_DIR=/run/user/1000 wayvnc -g -f 60 -o "$HEADLESS_NAME" 0.0.0.0 5900 > /dev/null 2>&1 &

sleep 1

# Detect IPs dynamically
WIFI_IP=$(ip -4 addr show wlan0 2>/dev/null | grep "inet " | awk '{print $2}' | cut -d/ -f1)
USB_IP=$(ip -4 addr | grep -E "enp0s20f0u|usb|rndis" | awk '{print $2}' | cut -d/ -f1 | head -n 1)

if [ -n "$USB_IP" ]; then
    notify-send -u critical -a "Android Monitor" "Direct USB Cable Ready!" "USB IP: $USB_IP:5900"
else
    notify-send -u normal -a "Android Monitor" "Wi-Fi Monitor Ready!" "Wi-Fi IP: ${WIFI_IP:-none}:5900"
fi

echo ""
echo "=================================================================="
echo "✅ VIRTUAL MONITOR IS READY (GPU ACCELERATED 60 FPS)!"
echo "=================================================================="
echo "📱 In your Android VNC App (AVNC / VNC Viewer), Connect to:"
echo ""
if [ -n "$USB_IP" ]; then
    echo "🔌 Direct USB Cable (Wi-Fi OFF):"
    echo "   👉 Host: $USB_IP"
    echo "   👉 Port: 5900"
    echo ""
fi
if [ -n "$WIFI_IP" ]; then
    echo "📶 Wi-Fi Connection:"
    echo "   👉 Host: $WIFI_IP"
    echo "   👉 Port: 5900"
    echo ""
fi
echo "🔑 Password: (None / Leave empty)"
echo "=================================================================="
